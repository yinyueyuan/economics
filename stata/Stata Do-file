// 1. Define treatment year (policy shock year = 2011)

// Post = 1 for all years ≥ 2011, 0 otherwise
gen Post = (Year >= 2011) & !missing(Year)

// Define treatment group: provinces covered by the ETS pilot policy
gen Treat = ///
   (Province == "Beijing") | ///
   (Province == "Tianjin") | ///
   (Province == "Shanghai") | ///
   (Province == "Chongqing") | ///
   (Province == "Hubei") | ///
   (Province == "Guangdong") | ///
   (Province == "Shenzhen")

// DID interaction term
gen TreatPost = Treat * Post

// 2. Empirical procedure (winsorization + descriptive statistics)

// Install winsorization package
ssc install winsor2

// Winsorize key variables at the 1st and 99th percentiles to reduce outlier impact
winsor2 IneInvest OverInv WeakInv TreatPost Treat Post Growth Lev CFO Age Asset Return ROA TanRatio Top1 Top10 Sep SOE, replace cuts(1 99)

// Create a global macro for control variables used in regressions
global X "Lev Age Asset Growth ROA CFO Top1 SOE"

// Export descriptive statistics table
sum2docx IneInvest OverInv WeakInv Treat Post TreatPost $X ///
    using Empirical_Results.docx, replace ///
    stats(N mean(%9.4f) sd(%9.4f) min(%9.4f) median(%9.4f) max(%9.4f)) ///
    title("Table 2 Descriptive Statistics")

// Export correlation matrix
corr2docx IneInvest TreatPost $X using Empirical_Results.docx, replace ///
    star(* 0.1 ** 0.05 *** 0.01) fmt(%9.4f) ///
    title("Table 3 Correlation Matrix")

// 3. Baseline DID regression

xi: reg IneInvest Treat Post TreatPost $X i.Year i.IndCode, r
est store m1

xi: reg OverInv Treat Post TreatPost $X i.Year i.IndCode, r
est store m2

xi: reg WeakInv Treat Post TreatPost $X i.Year i.IndCode, r
est store m3

reg2docx m1 m2 m3 using Empirical_Results.docx, append ///
    keep(Treat Post TreatPost $X) ///
    addfe("Year = Yes" "Industry = Yes") ///
    mtitles("IneInvest" "OverInv" "WeakInv") ///
    scalars(N r2(%9.4f)) b(%9.4f) t(%9.4f) ///
    title("Table 4 Impact of ETS Policy on Corporate Investment Efficiency") ///
    note("Note: ***, **, * indicate significance at the 1%, 5%, and 10% levels. Robust t-statistics in parentheses.")

// 4. Robustness Checks

// (1) Parallel Trends Test (Event study specification)
// Define relative year indicators (baseline = -1 or omitted group)
gen Dyear = Year - 2011
gen Before3 = (Dyear == -3 & Treat == 1)
gen Before2 = (Dyear == -2 & Treat == 1)
gen Before1 = (Dyear == -1 & Treat == 1)
gen Current = (Dyear == 0  & Treat == 1)
gen After1  = (Dyear == 1  & Treat == 1)
gen After2  = (Dyear == 2  & Treat == 1)
gen After3  = (Dyear == 3  & Treat == 1)

xi: reg IneInvest Before3 Before2 Before1 Current After1 After2 After3 ///
    $X i.Year i.IndCode, r
est store m1

xi: reg OverInv Before3 Before2 Before1 Current After1 After2 After3 ///
    $X i.Year i.IndCode, r
est store m2

xi: reg WeakInv Before3 Before2 Before1 Current After1 After2 After3 ///
    $X i.Year i.IndCode, r
est store m3

reg2docx m1 m2 m3 using Empirical_Results.docx, append ///
    keep(Before3 Before2 Before1 Current After1 After2 After3 $X) ///
    addfe("Year = Yes" "Industry = Yes") ///
    mtitles("IneInvest" "OverInv" "WeakInv") ///
    scalars(N r2(%9.4f)) b(%9.4f) t(%9.4f) ///
    title("Table 5 Parallel Trends Test") ///
    note("Note: ***, **, * indicate significance at the 1%, 5%, and 10% levels. Robust t-statistics in parentheses.")

// Plot event-study coefficients
coefplot m1 m2 m3, ///
    keep(Before3 Before2 Before1 Current After1 After2 After3) ///
    vertical recast(connect) yline(0)


// (2) Placebo Test (Random permutation)
// Run baseline regression to store real effect
sum
reghdfe IneInvest TreatPost, absorb(IndCode Year) vce(robust)

// Create file for placebo simulations
cap erase "simulations.dta"

// Randomly shuffle treatment 500 times and re-estimate DID each time
permute TreatPost beta = _b[TreatPost] se = _se[TreatPost] df = e(df_r), ///
    reps(500) seed(123) saving("simulations.dta"): ///
    reghdfe IneInvest TreatPost, absorb(IndCode Year) vce(robust)

// Load placebo results
use "simulations.dta", clear
gen t_value = beta / se
gen p_value = 2 * ttail(df, abs(t_value))

// Density plot of placebo distribution
dpplot beta

// Scatter plot of placebo p-values
use "simulations.dta", clear
gen t_value = beta / se
gen p_value = 2 * ttail(df, abs(t_value))

twoway ///
    (scatter p_value beta, msymbol(smcircle_hollow) mcolor(gray)), ///
    title("Placebo Test") ///
    xlabel(-0.003(0.001)0.003) ///
    ylabel(, angle(0)) ///
    yline(0.1, lwidth(vthin) lp(dash)) ///
    ytitle("p value") ///
    xline(-0.0068, lwidth(vthin) lp(shortdash)) ///
    xtitle("Estimated coefficient") ///
    plotregion(style(none)) graphregion(color(white))



// (3) Robustness: Change policy shock year to 2013
// Redefine Post = 1 for Year ≥ 2013
gen Post2 = 1 if Year >= 2013
replace Post2 = 0 if Post2 == .

gen TreatPost2 = Treat * Post2

xi: reg IneInvest Treat Post2 TreatPost2 $X i.Year i.IndCode, r
est store m1

xi: reg OverInv Treat Post2 TreatPost2 $X i.Year i.IndCode, r
est store m2

xi: reg WeakInv Treat Post2 TreatPost2 $X i.Year i.IndCode, r
est store m3

reg2docx m1 m2 m3 using Empirical_Results.docx, append ///
    keep(Treat Post2 TreatPost2 $X) ///
    addfe("Year = Yes" "Industry = Yes") ///
    mtitles("IneInvest" "OverInv" "WeakInv") ///
    scalars(N r2(%9.4f)) b(%9.4f) t(%9.4f) ///
    title("Table 6 Change of Policy Shock Year to 2013") ///
    note("Note: ***, **, * indicate significance at the 1%, 5%, and 10% levels. Robust t-statistics in parentheses.")
